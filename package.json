{
  "name": "prophets-family-tree",
  "private": true,
  "version": "2.4.3",
  "type": "module",
  "description": "Shajara — an interactive, source-cited family tree and timeline of the Prophets named in the Qur'an (ar/fr/en).",
  "author": "Oussama EL HADJI",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "verify:sources": "node scripts/verify-sources.mjs",
    "audit:content": "node scripts/audit-content.mjs",
    "credits:photos": "node scripts/trace-photo-credits.mjs",
    "images": "node scripts/images.mjs"
  },
  "dependencies": {
    "@fontsource-variable/reem-kufi": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@fontsource/amiri-quran": "5.3.0",
    "@types/leaflet": "^1.9.22",
    "d3-hierarchy": "3.1.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
